<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>CoderCommander</AssemblyName>
    <RootNamespace>CoderCommander</RootNamespace>
    <!-- Required by the source-generated [LibraryImport] marshalling code used throughout
         Terminal/Native/ (ConPTY P/Invoke) - the generator emits pointer/fixed-buffer code for
         several parameter shapes (out SafeHandle, ref struct, MarshalAs(Bool) on a blittable
         signature) that the compiler only allows under /unsafe. This does not relax safety
         checks anywhere else in the app; every unsafe construct is inside the generated
         marshalling stubs, not in hand-written code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Was unset, which makes ApplicationConfiguration.Initialize() (Program.cs) fall back to
         the SDK default of SystemAware - under that mode DeviceDpi is fixed at the primary
         monitor's startup DPI and Windows bitmap-stretches the window on any other monitor,
         instead of raising DpiChanged and letting the app rescale itself. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Audit Phase 3: analyzers scoped to the categories this audit actually cares about for an
         application (not a published library) - Security/Reliability/Usage/Globalization/
         Interoperability at full strength, Design/Naming/Documentation off outright (CA1002/CA1034/
         CA1051/CA1056/CA1063 etc. are public-API-surface advice for NuGet package authors and have
         no bearing on an internal .exe's own classes; naming/doc-comment style is a maintainability
         call, not a defect class, and CLAUDE.md already sets this repo's own comment conventions).
         Performance/Maintainability at the SDK default so genuine perf smells (CA1859/CA1849) still
         surface without the low-value noise (CA1822 "can be static" etc.) drowning them out. -->
    <AnalysisMode>Default</AnalysisMode>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <AnalysisModeUsage>All</AnalysisModeUsage>
    <AnalysisModeGlobalization>All</AnalysisModeGlobalization>
    <AnalysisModeInteroperability>All</AnalysisModeInteroperability>
    <AnalysisModeDesign>None</AnalysisModeDesign>
    <AnalysisModeNaming>None</AnalysisModeNaming>
    <AnalysisModeDocumentation>None</AnalysisModeDocumentation>
    <!-- Audit, continued (see DEBUG.md §0 - a summary preserved after AUDIT-FINDINGS.md was
         removed from the repo along with the test project; full detail is in git history):
         every warning category in this scoped analyzer configuration has been read file-by-file,
         not just triaged by rule name - CA1305/CA1307/CA1310, CA2000, CA2213 (§0.2), every
         compiler CS warning, CA2227, CA2215, and CA1308 (§0.3). Two rules
         remain warnings rather than errors below via WarningsNotAsErrors, not because they were
         skipped, but because every one of their current occurrences was individually confirmed to
         be either a structural false positive the analyzer cannot model (CA2213 - four documented
         ownership patterns, all 197 sites read) or a fix that would be actively wrong for this
         codebase (CA1308 - all 8 sites either risk a real regression or aren't a comparison at
         all). Suppressing either wholesale (like CA2007/CA1303 in this file below) would hide a
         genuinely new leak or an unrelated new ToLowerInvariant call at a site that DOES need
         ToUpperInvariant; leaving them as ordinary (non-fatal) warnings keeps them visible on
         every build without blocking one over a diagnosis already on record.-->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA2213;CA1308</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.ico" Pack="false" />
  </ItemGroup>

  <!-- UiTests is a separate FlaUI/NUnit test project nested under this folder for convenience -
       exclude it from this project's default SDK-style globbing so its packages/attributes don't
       leak into the main app's compilation. -->
  <ItemGroup>
    <Compile Remove="UiTests\**" />
    <EmbeddedResource Remove="UiTests\**" />
    <None Remove="UiTests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lang\*.lng" CopyToOutputDirectory="PreserveNewest" Link="lang\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
